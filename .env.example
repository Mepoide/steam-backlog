# Copia este fichero a .env y rellena los valores. .env está en .gitignore.
STEAM_API_KEY=
STEAM_ID=
# Biblioteca familiar: refresh token (dura meses, ver README). De él sale cada día
# el token que caduca en 24 h, así no hay que renovar nada a mano.
STEAM_REFRESH_TOKEN=
# Alternativa manual al anterior: el webapi_token de la tienda, caduca en ~24 h.
STEAM_WEBAPI_TOKEN=
# Bot (texto libre con Claude): console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Tope de gasto mensual en IA en dólares (1 por defecto; 0 = sin tope). Ver /coste en el bot.
LLM_MONTHLY_BUDGET_USD=
# Bot de Telegram: token de @BotFather; el chat_id sale en el log la primera vez (ver README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
